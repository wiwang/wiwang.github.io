{
  "name": "zhiyong-wang-blog",
  "version": "1.0.0",
  "private": true,
  "scripts": {
    "dev": "next dev",
    "build": "npm run validate && next build --webpack && node scripts/verify-export.mjs",
    "start": "node scripts/preview.mjs",
    "preview": "node scripts/preview.mjs",
    "typecheck": "next typegen && tsc --noEmit",
    "validate": "node --import tsx scripts/validate-content.ts",
    "new-post": "node scripts/new-post.mjs",
    "test": "node --import tsx --test scripts/content.test.ts",
    "format": "prettier --write src scripts docs .github *.json *.ts *.mjs README.md",
    "format:check": "prettier --check src scripts docs .github *.json *.ts *.mjs README.md"
  },
  "dependencies": {
    "github-slugger": "^2.0.0",
    "gray-matter": "^4.0.3",
    "katex": "^0.19.1",
    "mdast-util-to-string": "^4.0.0",
    "next": "^16.0.0",
    "next-mdx-remote": "^6.0.0",
    "react": "^19.2.0",
    "react-dom": "^19.2.0",
    "rehype-highlight": "^7.0.2",
    "rehype-katex": "^7.0.1",
    "rehype-slug": "^6.0.0",
    "remark-gfm": "^4.0.1",
    "remark-math": "^6.0.0",
    "unist-util-visit": "^5.0.0",
    "zod": "^4.0.0"
  },
  "devDependencies": {
    "@tailwindcss/postcss": "^4.0.0",
    "@types/mdast": "^4.0.0",
    "@types/node": "^22.0.0",
    "@types/react": "^19.0.0",
    "@types/react-dom": "^19.0.0",
    "prettier": "^3.9.10",
    "tailwindcss": "^4.0.0",
    "tsx": "^4.20.0",
    "typescript": "^5.9.0"
  },
  "overrides": {
    "katex": "$katex"
  },
  "engines": {
    "node": ">=22.12.0"
  },
  "type": "module"
}
